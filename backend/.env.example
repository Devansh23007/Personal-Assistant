APP_ENV=development
APP_SECRET_KEY=development-secret-key-for-local-testing-only-12345
DATABASE_URL=sqlite:///./personal_assistant.db
FRONTEND_ORIGIN=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================================
# OPTION 1: GROQ CLOUD (FREE TIER)
# ==========================================================
# Get your free key at: https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_API_KEY=
OPEN_TARGET_PREFERENCE=ask
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
SCREEN_VISION_MODEL=qwen/qwen3.8-27b
WHISPER_MODEL=whisper-large-v3-turbo
# Optional override; by default natural speech uses LLM_API_KEY and Groq TTS.
TTS_API_KEY=
TTS_BASE_URL=https://api.groq.com/openai/v1
TTS_MODEL=canopylabs/orpheus-v1-english

# Screen inspection is on-demand only. Screenshots are never saved.
SCREEN_BLOCKED_KEYWORDS=password,bank,incognito,private browsing,inprivate,paypal,upi,credit card,login,sign in,otp
SCREEN_BLOCKED_APPS=1password,bitwarden,keepass,lastpass,whatsapp,telegram,signal,authenticator

# ==========================================================
# OPTION 2: OLLAMA (100% LOCAL & OFFLINE - NO API KEY)
# ==========================================================
# For offline use on your RTX 3050 (6GB VRAM):
# Set LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b
# Set SCREEN_VISION_MODEL to an image-capable model available in Ollama to enable screen inspection.
