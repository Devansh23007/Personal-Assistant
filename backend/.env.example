APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret

# Database:
# For easy local dev without Docker/Postgres, use SQLite:
# DATABASE_URL=sqlite:///./personal_assistant.db
# For PostgreSQL via Docker or local service:
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/personal_assistant

FRONTEND_ORIGIN=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq uses an OpenAI-compatible API. Leave the key empty until you are ready to connect it.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
